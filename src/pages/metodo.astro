---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/posa/posa-1.jpg';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.nikestone.com/' },
    { '@type': 'ListItem', position: 2, name: 'Metodo', item: 'https://www.nikestone.com/metodo' },
  ],
};
---
<Base
  title="Il nostro metodo · Dove la pietra incontra le mani esperte · Nikestone"
  description="Il metodo Nikestone in 4 fasi: sopralluogo gratuito, preventivo dettagliato, fornitura selezionata in cava e posa artigianale con squadra interna. Dove la pietra incontra le mani esperte, senza intermediari."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbLd)} />

  <!-- HERO -->
  <section class="page-hero">
    <Image src={heroImg} alt="Posatori Nikestone al lavoro sulla posa di una pavimentazione in Pietra di Luserna" class="page-hero-bg" widths={[768, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container">
      <nav class="crumbs" aria-label="Percorso">
        <ol>
          <li><a href="/" data-i="nav.home">Home</a></li>
          <li><span aria-current="page" data-i="nav.process">Metodo</span></li>
        </ol>
      </nav>
      <p class="eyebrow" data-i="metodo.hero.eyebrow">Metodo</p>
      <h1 data-ihtml="metodo.hero.h1">Dove la pietra<br /><em>incontra le mani esperte.</em></h1>
    </div>
  </section>

  <!-- 4 STEP -->
  <section class="process" aria-label="Il nostro metodo">
    <div class="container">
      <ol class="steps">
        <li class="rev">
          <span class="step-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 5 C12.5 5 7 11 7 18.5 C7 28 20 39 20 39 C20 39 33 28 33 18.5 C33 11 27.5 5 20 5 Z"/><circle cx="20" cy="18" r="4.5"/><path d="M31 32 L43 44" stroke-width="2"/></svg></span>
          <span class="n" data-i="metodo.step.1.n">01</span><h3 data-i="metodo.step.1.h">Sopralluogo</h3>
          <p data-i="metodo.step.1.p">Visita gratuita per analizzare il contesto, valutare la fattibilità tecnica e ascoltare l'esigenza del progettista o del committente.</p>
        </li>
        <li class="rev">
          <span class="step-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5 H29 L37 13 V43 H12 Z"/><path d="M29 5 V13 H37"/><path d="M17 22 H30 M17 28 H30 M17 34 H24"/><path d="M27 35 l3 3 6 -7" stroke-width="2"/></svg></span>
          <span class="n" data-i="metodo.step.2.n">02</span><h3 data-i="metodo.step.2.h">Preventivo</h3>
          <p data-i="metodo.step.2.p">Quotazione dettagliata con selezione del materiale, finitura, schema di posa e tempistiche. Trasporto incluso nel prezzo finale.</p>
        </li>
        <li class="rev">
          <span class="step-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="28" width="15" height="12"/><rect x="24" y="28" width="15" height="12"/><rect x="15.5" y="14" width="15" height="12"/></svg></span>
          <span class="n" data-i="metodo.step.3.n">03</span><h3 data-i="metodo.step.3.h">Fornitura</h3>
          <p data-i="metodo.step.3.p">Selezione accurata in cava dei blocchi e del materiale di lavoro, taglio su misura e consegna in cantiere.</p>
        </li>
        <li class="rev">
          <span class="step-ico" aria-hidden="true"><svg viewBox="0 0 48 48" fill="currentColor"><path d="M16 14 C16 8 28 8 28 14 Z"/><rect x="15.5" y="13.5" width="13" height="2" rx="0.4"/><circle cx="22" cy="18.5" r="3"/><rect x="19" y="20.5" width="6" height="3"/><rect x="22" y="21" width="12" height="9"/><rect x="20" y="20" width="15" height="2.5" rx="1"/><rect x="20" y="28.5" width="15" height="2.5" rx="1"/><path d="M19 30.5 L22 30.5 L18.5 40 L15.5 40 Z"/><path d="M24 30.5 L27 30.5 L29 42 L26 42 Z"/></svg></span>
          <span class="n" data-i="metodo.step.4.n">04</span><h3 data-i="metodo.step.4.h">Posa</h3>
          <p data-i="metodo.step.4.p">Squadra interna di posatori specializzati. Cantiere pulito, consegna nei tempi concordati, garanzia sul lavoro eseguito.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band" aria-label="Inizia il progetto">
    <div class="container">
      <p class="eyebrow rev" style="color:var(--accent)" data-i="metodo.cta.eyebrow">Preventivo</p>
      <h2 class="rev" data-ihtml="metodo.cta.h">Partiamo dal <em>sopralluogo.</em></h2>
      <p class="rev" data-i="metodo.cta.sub">Prenota una visita gratuita: ti ricontattiamo entro 48 ore lavorative.</p>
      <div class="hero-actions rev"><a href="/contatti" class="btn btn-on-dark"><span data-i="cta.btn">Richiedi un preventivo</span> <span class="arrow">→</span></a></div>
    </div>
  </section>
</Base>
