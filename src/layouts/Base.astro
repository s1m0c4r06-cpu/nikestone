---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}
const { title, description = '', canonical, ogImage = '/og-cover.jpg', robots = 'index,follow,max-image-preview:large' } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// LocalBusiness (dati azienda) — incluso su ogni pagina
const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://www.nikestone.com/#business',
  name: 'Nikestone di Angelino Massimo',
  description: 'Posa di Pietra di Luserna per chalet di lusso, ville e hotel tra Italia, Francia e Svizzera. 40 anni di mestiere.',
  url: 'https://www.nikestone.com/',
  logo: 'https://www.nikestone.com/logo.png',
  image: 'https://www.nikestone.com/og-cover.jpg',
  telephone: '+39 331 638 1673',
  email: 'massimoangelino23@gmail.com',
  vatID: '13348430011',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Bagnolo 23',
    postalCode: '10060',
    addressLocality: 'Bibiana',
    addressRegion: 'TO',
    addressCountry: 'IT',
  },
  areaServed: ['IT', 'FR', 'CH'],
  sameAs: ['https://instagram.com/nikestone.it'],
};
---
<!doctype html>
<html lang="it" data-lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0c2135" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="robots" content={robots} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="Nikestone" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:url" content={url} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,300;1,9..144,400&family=Manrope:wght@300;400;500;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessLd)} />
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link" data-i="a11y.skip">Salta al contenuto</a>
  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <div class="cookie" id="cookie" role="dialog" aria-label="Informativa cookie">
    <p><span data-i="cookie.txt">Usiamo cookie tecnici e di statistica (Google Analytics) per migliorare il sito.</span> <a href="/cookie" data-i="cookie.more">Maggiori info</a>.</p>
    <div><button class="btn btn-on-dark btn-small" data-cookie data-i="cookie.accept">Accetto</button></div>
  </div>
  <script>import '../scripts/site.ts';</script>
</body>
</html>
